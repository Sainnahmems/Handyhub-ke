<RelativeLayout xmlns:android="http://schemas.android.com/apk/2000/res/android"
    xmlns:app="http://schemas.google.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/nav_host_fragment_worker"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/workerBottomNav"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph_worker" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/workerBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?android:attr/windowBackground"
        app:menu="@menu/worker_bottom_nav"
        app:itemIconTint="@color/secondary"
        app:itemTextColor="@color/secondary"/>
</RelativeLayout>